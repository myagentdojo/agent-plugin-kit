{
  "name": "agent-plugin-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "src/admission-bootstrap",
    "src/modules/*",
    "src/adapters/*"
  ],
  "packageManager": "bun@1.4.0",
  "description": "Contracts and maintenance tooling for Agent Plugin repositories, with a dependency-free Admission Bootstrap.",
  "repository": {
    "type": "git",
    "url": "https://github.com/myagentdojo/agent-plugin-kit.git"
  },
  "exports": {
    ".": "./src/interface.ts",
    "./admission-bootstrap": "./src/admission-bootstrap/interface.ts",
    "./plugin-payload-production": "./src/modules/plugin-payload-production/interface.ts",
    "./runtime-custody": "./src/modules/runtime-custody/interface.ts",
    "./release-and-git-engine": "./src/modules/release-and-git-engine/interface.ts",
    "./maintenance-command-contract": "./src/modules/maintenance-command-contract/interface.ts",
    "./harness-journeys": "./src/modules/harness-journeys/interface.ts",
    "./canary-qualification": "./src/modules/canary-qualification/interface.ts",
    "./qualification-evidence": "./src/modules/qualification-evidence/interface.ts",
    "./reusable-workflow-adapter": "./src/adapters/reusable-workflow-adapter/interface.ts"
  },
  "bin": {
    "agent-plugin-kit": "./src/adapters/maintenance-command-facade/maintenance.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "1.4.0",
    "fallow": "3.19.0",
    "typescript": "7.0.2"
  },
  "scripts": {
    "check": "git diff --check && bun run biome:check && bun run typecheck && bun run check:structure && bun run test:quality:fallow-policy && bun run --silent quality:fallow --changed-since HEAD && bun run verify:intentional-red",
    "biome:check": "biome check --diagnostic-level=error .",
    "biome:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check:structure": "bun run clean-fixture/verify-intentional-red-contract.ts --structure-only",
    "quality:fallow": "bun run tooling/repository-quality/fallow-policy.ts",
    "test:quality:fallow-policy": "bun test tooling/repository-quality/contract-tests/fallow-policy.test.ts",
    "verify:intentional-red": "bun run clean-fixture/verify-intentional-red-contract.ts",
    "test:intentional-red": "bun test clean-fixture/personal-verification-profile/contract-tests/package-export-catalog.test.ts src/admission-bootstrap/contract-tests/admitted-identity-before-execution.test.ts src/admission-bootstrap/contract-tests/identity-refusal.test.ts src/modules/maintenance-command-contract/contract-tests/effect-class-and-retry-safety.test.ts src/modules/maintenance-command-contract/contract-tests/human-and-agent-result-vocabulary.test.ts src/modules/maintenance-command-contract/contract-tests/branch-station-catalog.test.ts src/modules/qualification-evidence/contract-tests/candidate-lineage-reduction.test.ts src/modules/qualification-evidence/contract-tests/proof-layer-and-non-claim.test.ts clean-fixture/personal-verification-profile/contract-tests/admission-and-invocation.test.ts clean-fixture/personal-verification-profile/contract-tests/installation-evidence.test.ts clean-fixture/personal-verification-profile/contract-tests/fresh-native-non-claims.test.ts clean-fixture/public-verification-profile/contract-tests/profile-non-promotion.test.ts clean-fixture/personal-verification-profile/contract-tests/maintenance-cli.test.ts clean-fixture/personal-verification-profile/contract-tests/maintenance-cli-local-link.test.ts src/adapters/maintenance-command-facade/contract-tests/command-surface.test.ts src/adapters/maintenance-command-facade/contract-tests/public-process.test.ts src/adapters/maintenance-command-facade/contract-tests/observability.test.ts",
    "test:intentional-red:kit-interface": "bun test clean-fixture/personal-verification-profile/contract-tests/package-export-catalog.test.ts",
    "test:intentional-red:admission-bootstrap": "bun test src/admission-bootstrap/contract-tests/admitted-identity-before-execution.test.ts src/admission-bootstrap/contract-tests/identity-refusal.test.ts",
    "test:intentional-red:maintenance-command-contract": "bun test src/modules/maintenance-command-contract/contract-tests/effect-class-and-retry-safety.test.ts src/modules/maintenance-command-contract/contract-tests/human-and-agent-result-vocabulary.test.ts src/modules/maintenance-command-contract/contract-tests/branch-station-catalog.test.ts",
    "test:intentional-red:qualification-evidence": "bun test src/modules/qualification-evidence/contract-tests/candidate-lineage-reduction.test.ts src/modules/qualification-evidence/contract-tests/proof-layer-and-non-claim.test.ts",
    "test:intentional-red:clean-fixture": "bun test clean-fixture/personal-verification-profile/contract-tests/package-export-catalog.test.ts clean-fixture/personal-verification-profile/contract-tests/admission-and-invocation.test.ts clean-fixture/personal-verification-profile/contract-tests/installation-evidence.test.ts clean-fixture/personal-verification-profile/contract-tests/fresh-native-non-claims.test.ts clean-fixture/public-verification-profile/contract-tests/profile-non-promotion.test.ts clean-fixture/personal-verification-profile/contract-tests/maintenance-cli.test.ts clean-fixture/personal-verification-profile/contract-tests/maintenance-cli-local-link.test.ts",
    "test:intentional-red:maintenance-cli:unit": "bun test src/adapters/maintenance-command-facade/contract-tests/command-surface.test.ts",
    "test:intentional-red:maintenance-cli:catalog": "bun test src/modules/maintenance-command-contract/contract-tests/branch-station-catalog.test.ts",
    "test:intentional-red:maintenance-cli:process": "bun test src/adapters/maintenance-command-facade/contract-tests/public-process.test.ts",
    "test:intentional-red:maintenance-cli:observability": "bun test src/adapters/maintenance-command-facade/contract-tests/observability.test.ts",
    "test:intentional-red:maintenance-cli:clean-fixture": "bun test clean-fixture/personal-verification-profile/contract-tests/maintenance-cli.test.ts",
    "test:intentional-red:maintenance-cli:local-link": "bun test clean-fixture/personal-verification-profile/contract-tests/maintenance-cli-local-link.test.ts",
    "test:intentional-red:maintenance-cli": "bun test src/adapters/maintenance-command-facade/contract-tests/command-surface.test.ts src/modules/maintenance-command-contract/contract-tests/branch-station-catalog.test.ts src/adapters/maintenance-command-facade/contract-tests/public-process.test.ts src/adapters/maintenance-command-facade/contract-tests/observability.test.ts clean-fixture/personal-verification-profile/contract-tests/maintenance-cli.test.ts clean-fixture/personal-verification-profile/contract-tests/maintenance-cli-local-link.test.ts",
    "audit:maintenance-cli": "bun run clean-fixture/audit-maintenance-cli.ts",
    "verify:maintenance-cli:local-link": "bun run clean-fixture/verify-maintenance-cli-local-link.ts"
  }
}
