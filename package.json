{
  "name": "agent-plugin-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "src/admission-bootstrap",
    "src/modules/*",
    "src/adapters/*"
  ],
  "packageManager": "bun@1.4.0",
  "description": "Contracts and maintenance tooling for Agent Plugin repositories, with a dependency-free Admission Bootstrap.",
  "repository": {
    "type": "git",
    "url": "https://github.com/myagentdojo/agent-plugin-kit.git"
  },
  "exports": {
    ".": "./src/interface.ts",
    "./admission-bootstrap": {
      "types": "./src/admission-bootstrap/interface.ts",
      "import": "./src/admission-bootstrap/implementation/admission-bootstrap.ts",
      "default": "./src/admission-bootstrap/implementation/admission-bootstrap.ts"
    },
    "./plugin-payload-production": "./src/modules/plugin-payload-production/interface.ts",
    "./runtime-custody": "./src/modules/runtime-custody/interface.ts",
    "./release-and-git-engine": "./src/modules/release-and-git-engine/interface.ts",
    "./maintenance-command-contract": "./src/modules/maintenance-command-contract/interface.ts",
    "./harness-journeys": "./src/modules/harness-journeys/interface.ts",
    "./canary-qualification": "./src/modules/canary-qualification/interface.ts",
    "./qualification-evidence": {
      "types": "./src/modules/qualification-evidence/interface.ts",
      "import": "./src/modules/qualification-evidence/implementation/qualification-evidence.ts",
      "default": "./src/modules/qualification-evidence/implementation/qualification-evidence.ts"
    },
    "./reusable-workflow-adapter": "./src/adapters/reusable-workflow-adapter/interface.ts"
  },
  "bin": {
    "agent-plugin-kit": "./src/adapters/maintenance-command-facade/maintenance.ts"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "1.4.0",
    "fallow": "3.19.0",
    "typescript": "7.0.2"
  },
  "scripts": {
    "check": "git diff --check && bun run biome:check && bun run typecheck && bun run --silent test:current-stage && bun run test:quality:repository && bun run --silent quality:fallow && bun run verify:repository",
    "biome:check": "biome check --diagnostic-level=error .",
    "biome:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "quality:fallow": "sh -c 'node_modules/.bin/fallow audit --format json --quiet --type-aware --type-aware-require best-effort \"$@\" | bun -e '\\''const report = JSON.parse(await new Response(Bun.stdin).text()); const typeAware = report._meta?.type_aware; const projects = typeAware?.projects; const queries = typeAware?.queries; const expectedQuery = (query) => query?.query_id === 0 && query?.capability === \"type-coupling\" && query?.assertion === \"coupling-found\"; const expectedAction = \"Narrow the query to a specific symbol, entry point, or healthy TypeScript project and retry.\"; const emittedEvidence = typeAware?.type_coupling?.files?.flatMap((file) => Array.isArray(file?.edges) ? file.edges : []) ?? []; const emittedEvidenceCount = new Set(emittedEvidence.map((edge) => JSON.stringify(edge))).size; const boundedPartial = (query) => { const total = query?.total_evidence_count; const omissions = query?.omissions; const coupling = typeAware?.type_coupling; const couplingOmissions = coupling?.omissions; return expectedQuery(query) && query?.status === \"partial\" && query.reason_code === \"evidence-limit\" && Number.isInteger(total) && total > 40 && query.truncated === true && emittedEvidenceCount === 40 && Array.isArray(omissions) && omissions.length === 1 && omissions[0]?.reason_code === \"evidence-limit\" && omissions[0]?.count === total - 40 && Array.isArray(couplingOmissions) && couplingOmissions.length === 1 && couplingOmissions[0]?.reason_code === \"evidence-limit\" && couplingOmissions[0]?.count === total - 40 && Array.isArray(coupling?.files) && coupling?.assertion === \"coupling-found\" && coupling?.status === \"partial\" && Array.isArray(coupling?.actions) && coupling.actions.length === 1 && coupling.actions[0] === expectedAction && Array.isArray(query.actions) && query.actions.length === 1 && query.actions[0] === expectedAction; }; const accepted = report.verdict === \"pass\" && Array.isArray(projects) && projects.length > 0 && projects.every((project) => project?.status === \"complete\" && project.blocking_diagnostic_count === 0) && Array.isArray(queries) && queries.length > 0 && queries.some(expectedQuery) && queries.every((query) => query?.status === \"complete\" || boundedPartial(query)); process.stdout.write(JSON.stringify(report) + \"\\n\"); if (!accepted) process.exitCode = 1'\\'' --' _",
    "test:quality:fallow-policy": "bun test tooling/repository-quality/contract-tests/fallow-native.test.ts",
    "test:quality:repository": "bun test tooling/repository-quality/contract-tests/biome-policy.test.ts tooling/repository-quality/contract-tests/fallow-native.test.ts tooling/repository-quality/contract-tests/repository-verification.test.ts tooling/repository-quality/contract-tests/current-stage-test-runner.test.ts",
    "verify:repository": "bun run tooling/repository-quality/verify-repository.ts",
    "test:current-stage": "bun run tooling/current-stage-test-runner.ts clean-fixture/personal-verification-profile/contract-tests/package-export-catalog.test.ts src/admission-bootstrap/contract-tests/admitted-identity-before-execution.test.ts src/admission-bootstrap/contract-tests/identity-refusal.test.ts src/modules/maintenance-command-contract/contract-tests/effect-class-and-retry-safety.test.ts src/modules/maintenance-command-contract/contract-tests/human-and-agent-result-vocabulary.test.ts src/modules/maintenance-command-contract/contract-tests/branch-station-catalog.test.ts src/modules/maintenance-command-contract/contract-tests/wire-command-and-binding.test.ts src/modules/qualification-evidence/contract-tests/candidate-lineage-reduction.test.ts src/modules/qualification-evidence/contract-tests/proof-layer-and-non-claim.test.ts clean-fixture/personal-verification-profile/contract-tests/admission-and-invocation.test.ts clean-fixture/personal-verification-profile/contract-tests/installation-evidence.test.ts clean-fixture/personal-verification-profile/contract-tests/fresh-native-non-claims.test.ts clean-fixture/public-verification-profile/contract-tests/profile-non-promotion.test.ts clean-fixture/personal-verification-profile/contract-tests/maintenance-cli.test.ts clean-fixture/personal-verification-profile/contract-tests/maintenance-cli-local-link.test.ts src/adapters/maintenance-command-facade/contract-tests/command-surface.test.ts src/adapters/maintenance-command-facade/contract-tests/public-process.test.ts src/adapters/maintenance-command-facade/contract-tests/observability.test.ts src/modules/plugin-payload-production/contract-tests/serialized-values.test.ts src/modules/release-and-git-engine/contract-tests/serialized-values.test.ts src/modules/harness-journeys/contract-tests/serialized-values.test.ts src/modules/canary-qualification/contract-tests/serialized-values.test.ts src/modules/canary-qualification/contract-tests/authority-source.test.ts",
    "test:current-stage:kit-interface": "bun test clean-fixture/personal-verification-profile/contract-tests/package-export-catalog.test.ts",
    "test:current-stage:admission-bootstrap": "bun test src/admission-bootstrap/contract-tests/admitted-identity-before-execution.test.ts src/admission-bootstrap/contract-tests/identity-refusal.test.ts",
    "test:current-stage:maintenance-command-contract": "bun test src/modules/maintenance-command-contract/contract-tests/effect-class-and-retry-safety.test.ts src/modules/maintenance-command-contract/contract-tests/human-and-agent-result-vocabulary.test.ts src/modules/maintenance-command-contract/contract-tests/branch-station-catalog.test.ts src/modules/maintenance-command-contract/contract-tests/wire-command-and-binding.test.ts",
    "test:current-stage:plugin-payload-production": "bun test src/modules/plugin-payload-production/contract-tests/serialized-values.test.ts",
    "test:current-stage:release-and-git-engine": "bun test src/modules/release-and-git-engine/contract-tests/serialized-values.test.ts",
    "test:current-stage:harness-journeys": "bun test src/modules/harness-journeys/contract-tests/serialized-values.test.ts",
    "test:current-stage:canary-qualification": "bun test src/modules/canary-qualification/contract-tests/serialized-values.test.ts src/modules/canary-qualification/contract-tests/authority-source.test.ts",
    "test:current-stage:qualification-evidence": "bun test src/modules/qualification-evidence/contract-tests/candidate-lineage-reduction.test.ts src/modules/qualification-evidence/contract-tests/proof-layer-and-non-claim.test.ts",
    "test:current-stage:clean-fixture": "bun test clean-fixture/personal-verification-profile/contract-tests/package-export-catalog.test.ts clean-fixture/personal-verification-profile/contract-tests/admission-and-invocation.test.ts clean-fixture/personal-verification-profile/contract-tests/installation-evidence.test.ts clean-fixture/personal-verification-profile/contract-tests/fresh-native-non-claims.test.ts clean-fixture/public-verification-profile/contract-tests/profile-non-promotion.test.ts clean-fixture/personal-verification-profile/contract-tests/maintenance-cli.test.ts clean-fixture/personal-verification-profile/contract-tests/maintenance-cli-local-link.test.ts",
    "test:current-stage:maintenance-cli:unit": "bun test src/adapters/maintenance-command-facade/contract-tests/command-surface.test.ts",
    "test:current-stage:maintenance-cli:catalog": "bun test src/modules/maintenance-command-contract/contract-tests/branch-station-catalog.test.ts",
    "test:current-stage:maintenance-cli:process": "bun test src/adapters/maintenance-command-facade/contract-tests/public-process.test.ts",
    "test:current-stage:maintenance-cli:observability": "bun test src/adapters/maintenance-command-facade/contract-tests/observability.test.ts",
    "test:current-stage:maintenance-cli:clean-fixture": "bun test clean-fixture/personal-verification-profile/contract-tests/maintenance-cli.test.ts",
    "test:current-stage:maintenance-cli:local-link": "bun test clean-fixture/personal-verification-profile/contract-tests/maintenance-cli-local-link.test.ts",
    "test:current-stage:maintenance-cli": "bun test src/adapters/maintenance-command-facade/contract-tests/command-surface.test.ts src/modules/maintenance-command-contract/contract-tests/branch-station-catalog.test.ts src/adapters/maintenance-command-facade/contract-tests/public-process.test.ts src/adapters/maintenance-command-facade/contract-tests/observability.test.ts clean-fixture/personal-verification-profile/contract-tests/maintenance-cli.test.ts clean-fixture/personal-verification-profile/contract-tests/maintenance-cli-local-link.test.ts",
    "audit:maintenance-cli": "bun run clean-fixture/audit-maintenance-cli.ts",
    "verify:maintenance-cli:local-link": "bun run clean-fixture/verify-maintenance-cli-local-link.ts"
  }
}
